{
  "version": 2,
  "functions": {
    "vercel-build.js": { "runtime": "nodejs20.x" },
    "api-hello.js": { "runtime": "nodejs20.x" }
  },
  "routes": [
    { "src": "^/api/test$", "dest": "/vercel-build.js" },
